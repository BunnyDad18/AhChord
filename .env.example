# ============ PostgreSQL ============
POSTGRES_USER=ahchord
POSTGRES_PASSWORD=changeme-local-only
POSTGRES_DB=ahchord

# ============ Application ============
ASPNETCORE_ENVIRONMENT=Production

# ============ JWT ============
# Use a long random string in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-string
# Token lifetime in minutes. Default 43200 = 30 days (ST-35 A2: stay signed in).
JWT_EXPIRY_MINUTES=43200

# ============ Test access (optional) ============
# When set, a fixed "agent" account (agent@ahchord.local) is seeded at startup for
# unattended testing (ST-35 A3). Leave empty on deployments without test access.
TEST_USER_PASSWORD=

# ============ LLM (optional - used by ST-14 in-app auto-conversion) ============
# Any OpenAI-compatible server: Ollama (http://localhost:11434/v1) or
# LM Studio (http://localhost:1234/v1), local or LAN. Leave LLM_BASE_URL empty
# to disable in-app conversion (the paste flow keeps working).
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3.8
LLM_API_KEY=not-needed
# Thinking models (Qwen3 thinking, etc.) need a token cap or they reason
# unbounded before emitting and the request times out. 4096 is a good default.
LLM_MAX_TOKENS=4096
# Per-request timeout in seconds (default 300 - shared-GPU thinking models are slow).
LLM_TIMEOUT_SECONDS=300
# SSRF policy for the member-facing LLM endpoints (Settings -> LLM "Test", and the stored
# per-user base URL used at conversion time). true (default) = a member may point the server
# at a local/LAN model, which is the normal self-hosted shape. Set false on an instance that
# faces the internet: loopback, RFC1918, CGNAT, link-local (cloud metadata), multicast, IPv6
# local ranges and internal names (localhost, .local/.test/.internal/.lan/.home, single-label
# hosts) are refused; redirects are never followed on the LLM clients; and a public hostname
# that resolves into the network is refused at the socket. LLM_BASE_URL (operator config) is
# not policed - set false on a public demo and leave LLM_BASE_URL empty, which disables the
# surface entirely (the endpoints answer 503).
LLM_ALLOW_PRIVATE_NETWORK=true
# Override the conversion prompt file (defaults to ./prompts/chord-page-to-chordpro.md).
# LLM_PROMPT_FILE=/abs/path/to/prompt.md

# ============ Public-demo hardening (ST-90) ============
# Everything here defaults to the self-hosted band server: open registration, shared library
# writes, generous limits. Set them on an instance that faces the internet (see SECURITY.md).

# false closes POST /api/auth/register (403 "registration-closed"): accounts are the seeded
# admin below plus whoever is already there.
REGISTRATION_OPEN=true
# Seed an admin at startup (idempotent: once any admin exists, nothing happens, and an existing
# username is promoted rather than duplicated). With REGISTRATION_OPEN=false and an empty
# database this is the only way in, so set it together with closing registration.
SEED_ADMIN_USERNAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# true = only the admin can destroy or rename shared structure: delete a source file, rename
# or delete a collection, triage bug reports. Additive writes stay open for every member
# (upload a file, create a collection, report a bug) — that is the shared-library product.
LIBRARY_WRITES_ADMIN_ONLY=false

# Every JWT carries the Identity security stamp and it is checked per request, so a password
# change revokes tokens issued before it. OFF by default: turning it on ends every token issued
# before it (all devices sign in again once) and a password change signs out every device — the
# device that changed the password gets a replacement token and stays in. Set true on an
# internet-facing demo.
JWT_STAMP_CHECK=false

# Fixed-window rate limits, partitioned per signed-in user and per client address for the
# anonymous auth endpoints. The defaults are deliberately loose: a band never trips them.
RATE_LIMIT_AUTH_PERMIT=30
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_IMPORT_PERMIT=10
RATE_LIMIT_IMPORT_WINDOW_SECONDS=60

# Comma-separated proxy addresses whose X-Forwarded-For is trusted (Traefik/Caddy/nginx).
# Exact addresses and CIDR blocks are accepted — on a docker network the subnet is the normal
# value (e.g. 172.18.0.0/16), because the proxy's address moves on every redeploy. Unset = the
# header is ignored (an unauthenticated forwarded header is a spoofable client address). Set it
# behind a proxy, or the auth limiter shares one bucket across the whole site. Chained proxies
# (Cloudflare -> Traefik) need every proxy's ranges listed; see SECURITY.md gate 2.
TRUSTED_PROXY_IPS=
